# =============================================================================
# SmartSearch AI -- Root Git Ignore
# =============================================================================

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Large dataset files & databases (strictly exceed GitHub 100MB limit)
data/
**/data/
*.sqlite3
*.sqlite3-journal
*.parquet
*.jsonl
*.bin
*.tar.gz
*.zip

# Model checkpoints (regenerated via train.py)
models/**/*.pt
models/**/*.pth

# OS and IDE files
.DS_Store
Thumbs.db
*.lnk
.idea/
.vscode/

# Environment files with secrets
.env
*.local

# Logs
*.log
