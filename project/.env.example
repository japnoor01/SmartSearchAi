# =============================================================================
# SmartSearch AI -- Environment Variables Template
# =============================================================================
# Copy this file to .env and adjust variables for your deployment environment.
# Never commit real API secrets or credentials to source control.

# Application Environment Mode ('development', 'production', or 'testing')
SMARTSEARCH_ENV=production

# Server Network Binding
SMARTSEARCH_HOST=0.0.0.0
SMARTSEARCH_PORT=8000

# Artifact & Storage Paths
# In Docker, the SQLite index is mounted to /app/data/indexes/prefix_real/
SMARTSEARCH_INDEX_PATH=/app/data/indexes/prefix_real/prefix_index.sqlite3
SMARTSEARCH_MODEL_PATH=models/lstm/best_model.pt
SMARTSEARCH_TOKENIZER_PATH=models/lstm/tokenizer

# Execution Hardware Device ('auto', 'cpu', or 'cuda')
SMARTSEARCH_DEVICE=cpu

# Cross-Origin Resource Sharing (CORS)
# In production, provide an explicit comma-separated list of allowed origins.
SMARTSEARCH_CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000

# Rate Limiting Configuration (In-Memory Sliding Window)
SMARTSEARCH_RATE_LIMIT_ENABLED=true
SMARTSEARCH_RATE_LIMIT_REQUESTS=120
SMARTSEARCH_RATE_LIMIT_WINDOW_SECONDS=60.0

# Request Timeout (Seconds before canceling slow retrieval / inference)
SMARTSEARCH_REQUEST_TIMEOUT_SECONDS=5.0

# Server Logging
SMARTSEARCH_LOG_LEVEL=INFO
SMARTSEARCH_LOG_QUERIES=false

# Website Trust & Safety Intelligence
# If left blank, external reputation checks are reported as unavailable (no fake results)
SMARTSEARCH_SAFE_BROWSING_API_KEY=
SMARTSEARCH_VIRUSTOTAL_API_KEY=
SMARTSEARCH_TRUST_ENABLED=true
SMARTSEARCH_TRUST_CACHE_TTL=300.0
SMARTSEARCH_PARTNERS_PATH=configs/verified_partners.yaml

# Cloudflare Tunnel Configuration (Public HTTPS Access)
# Optional: To use a permanent named tunnel on your custom domain,
# enter your Cloudflare Zero Trust tunnel token here.
# If left empty, start_tunnel.ps1 automatically creates a free Quick Tunnel (*.trycloudflare.com).
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_COMMAND=

