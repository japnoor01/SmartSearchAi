# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual envs
.venv/
venv/

# Large / generated data -- never commit raw or processed query dumps
data/processed/
data/raw/
data/indexes/prefix/*.sqlite3
data/synthetic/**/*.jsonl

# Model artifacts -- checkpoints are large binaries, regenerate via train.py
models/**/*.pt
models/**/*.pth

# Reports/logs that are regenerated by scripts, not hand-authored
*.log

# Binaries & scratch
ngrok.exe
scratch/
.env
data/indexes/prefix_real/*.sqlite3

# OS/editor cruft
.DS_Store
.idea/
.vscode/
