{
  "manifest_version": 3,
  "name": "SmartSearch AI — Search Autocomplete",
  "version": "1.0.0",
  "description": "Google-style search auto-suggestion and query recommendation powered by LSTM ranking and FastAPI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SmartSearch AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/logic.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ]
}
